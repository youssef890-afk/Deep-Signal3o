# Deep Signal — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in the values. Never commit
# a real `.env` file. Nothing here is a secret: the two `VITE_*` values are meant
# to be public (the anon key is protected by Row Level Security) and every other
# value in this file is only a name, not a credential.
#
# ---------------------------------------------------------------------------
# Client-side (VITE_*) — safe to ship in the browser bundle
# ---------------------------------------------------------------------------

# Project URL from Supabase → Project Settings → API
VITE_SUPABASE_URL=

# "anon" / "publishable" key. This key is public by design; RLS is what protects
# the data. NEVER use the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Optional. Only needed by the Voice Card Clash game (LiveKit transport).
# See supabase/functions/livekit-token/README.md
VITE_LIVEKIT_URL=

# ---------------------------------------------------------------------------
# Server-side only — Supabase Edge Function secrets
# ---------------------------------------------------------------------------
# Set these with `npx supabase secrets set KEY=value`. They must never appear in
# any VITE_ variable, in src/, or in public/.
#
#   npx supabase secrets set OPENAI_API_KEY=... ANTHROPIC_API_KEY=... GEMINI_API_KEY=...
#   npx supabase secrets set LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...
#
# OPENAI_API_KEY           required by the ai-assistant function
# ANTHROPIC_API_KEY        optional, for a future Jokal provider
# GEMINI_API_KEY           optional, for a future Jokal provider
# XAI_API_KEY              optional, for a future Jokal provider
# LIVEKIT_API_KEY          required by livekit-token
# LIVEKIT_API_SECRET       required by livekit-token
#
# Optional tuning (defaults are safe defaults, not prices):
#   AI_PROVIDER                     provider label stored in ai_usage
#   AI_TEXT_MODEL / AI_IMAGE_MODEL   model ids
#   AI_RATE_LIMIT_TEXT / AI_RATE_WINDOW_TEXT
#   AI_RATE_LIMIT_IMAGE / AI_RATE_WINDOW_IMAGE
#   AI_COST_PER_1K_INPUT_USD / AI_COST_PER_1K_OUTPUT_USD / AI_COST_PER_IMAGE_USD
#   ALLOWED_ORIGINS                 comma separated origins; empty means "*"
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically to Edge Functions by Supabase and must not be set manually.